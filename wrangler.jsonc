{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "growthops-api",
	"main": "apps/api/cf-worker/index.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"containers": [
		{
			// TEMPORARY diagnostic swap — testing whether a trivial public
			// image schedules successfully, to isolate whether the
			// "container not running" failure is specific to our own
			// image/app or a platform-wide scheduling bug. Revert to
			// "./Dockerfile.api" once this test is done.
			"image": "docker.io/library/nginx:alpine",
			"class_name": "ApiContainer",
			"max_instances": 2,
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "API_CONTAINER",
				"class_name": "ApiContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ApiContainer"
			]
		}
	],
	// Real config, created 2026-07-24 via `wrangler hyperdrive create`
	// against the live Neon Postgres instance — verified working, not a
	// placeholder anymore.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "2f4f569f05d94ab695acd31419780fe5"
		}
	]
	// Secrets confirmed working 2026-07-24: set via `wrangler secret put`,
	// forwarded into the container via the Container subclass constructor
	// reading `env` and setting `this.envVars` (apps/api/cf-worker/index.ts).
}