{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "growthops-api",
	"main": "apps/api/cf-worker/index.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"containers": [
		{
			"image": "./Dockerfile.api",
			"class_name": "ApiContainer",
			"max_instances": 2,
			// Default is "lite" (256MiB RAM, 0.0625 vCPU) — confirmed via
			// `wrangler containers info` that the app was OOM-crashing on
			// boot before ever binding to the port ("healthy" sandbox, but
			// 0 active instances). A real NestJS app (Prisma, BullMQ,
			// Passport, etc.) needs real headroom.
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "API_CONTAINER",
				"class_name": "ApiContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ApiContainer"
			]
		}
	],
	// Real config, created 2026-07-24 via `wrangler hyperdrive create`
	// against the live Neon Postgres instance — verified working, not a
	// placeholder anymore.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "2f4f569f05d94ab695acd31419780fe5"
		}
	]
	// Secrets confirmed working 2026-07-24: set via `wrangler secret put`,
	// forwarded into the container via the Container subclass constructor
	// reading `env` and setting `this.envVars` (apps/api/cf-worker/index.ts).
}