# Local dev values match docker-compose defaults. Production values live in the
# deploy platform's secret store — never in this repo.
DATABASE_URL=postgresql://growthops_app:growthops_app@localhost:5433/growthops
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/growthops
REDIS_URL=redis://localhost:6380
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
PORT=3000

# Web Push (browser alerts — no email/SMS provider needed). Generated once via
# `node -e "console.log(require('web-push').generateVAPIDKeys())"`; the
# public key must match apps/web/.env's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
PUSH_VAPID_PUBLIC_KEY=BCiVMlXadMuDekKkGpulHx29AxB1wRVuptu6TF2DIzOIMO792-Dpj7gXuxjKb-LmA8B2eF1t44RAa6hhSapsyI8
PUSH_VAPID_PRIVATE_KEY=gNNno6bzEDCvTs7uSROPxpO63GaMwzLOlncw2brGLbY
