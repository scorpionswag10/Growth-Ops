generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ── Platform layer (not tenant-scoped) ──────────────────────────────

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  passwordHash    String
  name            String
  isPlatformAdmin Boolean      @default(false)
  memberships     Membership[]
  refreshTokens   RefreshToken[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// A Location is one client business (tenant). Every tenant-scoped table
// carries locationId and gets an RLS policy in prisma/rls.sql.
model Location {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  timezone    String         @default("America/New_York")
  status      LocationStatus @default(ACTIVE)
  // Entitlement flags: features exist in code but are OFF per tenant until
  // GrowthOps is ready to offer them (e.g. sms stays false until A2P 10DLC
  // registration for this tenant is approved).
  features    Json           @default("{\"sms\": false, \"email\": false, \"booking\": false, \"social\": false, \"workflows\": false}")
  // Secret path segment for this location's public lead-capture webhook
  // (LeadPages form integrations POST here). Rotatable by regenerating.
  webhookToken String        @unique @default(uuid()) @db.Uuid
  // Secret path segment for the client-facing live growth report.
  reportToken  String        @unique @default(uuid()) @db.Uuid
  memberships Membership[]
  costEvents  CostEvent[]
  contacts        Contact[]
  customFieldDefs CustomFieldDef[]
  pipelines       Pipeline[]
  pipelineStages  PipelineStage[]
  opportunities   Opportunity[]
  conversations   Conversation[]
  messages        Message[]
  calendars       Calendar[]
  appointments    Appointment[]
  workflows       Workflow[]
  workflowExecutions WorkflowExecution[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("locations")
}

enum LocationStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Membership {
  id         String     @id @default(uuid()) @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String     @db.Uuid
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String     @db.Uuid
  role       MemberRole @default(STAFF)
  createdAt  DateTime   @default(now())

  @@unique([userId, locationId])
  @@map("memberships")
}

enum MemberRole {
  OWNER
  ADMIN
  STAFF
}

// ── Tenant layer (RLS-protected) ────────────────────────────────────

// Internal provider-cost ledger. Not client billing — GrowthOps clients pay a
// flat retainer — but every provider action logs its cost here from day one
// so margins are visible and metering never has to be retrofitted.
model CostEvent {
  id          String   @id @default(uuid()) @db.Uuid
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String   @db.Uuid
  type        CostType
  provider    String
  providerRef String?
  quantity    Decimal  @default(1) @db.Decimal(12, 4)
  unitCost    Decimal  @default(0) @db.Decimal(12, 6)
  totalCost   Decimal  @default(0) @db.Decimal(12, 6)
  meta        Json?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([provider, providerRef, type])
  @@index([locationId, occurredAt])
  @@map("cost_events")
}

// The hub entity everything hangs off. Identity within a location resolves on
// email first, then phone (upsert semantics in ContactsService) — one person,
// one contact, however they arrive.
model Contact {
  id            String        @id @default(uuid()) @db.Uuid
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String        @db.Uuid
  firstName     String?
  lastName      String?
  email         String?
  phone         String? // E.164
  source        String?
  timezone      String?
  dndSms        Boolean       @default(false)
  dndEmail      Boolean       @default(false)
  tags          String[]      @default([])
  customFields  Json          @default("{}")
  opportunities Opportunity[]
  conversations Conversation[]
  messages      Message[]
  appointments  Appointment[]
  workflowExecutions WorkflowExecution[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([locationId, email])
  @@unique([locationId, phone])
  @@index([locationId, createdAt])
  @@map("contacts")
}

// Per-tenant schema for Contact.customFields — tenants define their own
// fields; writes are validated against these definitions.
model CustomFieldDef {
  id         String          @id @default(uuid()) @db.Uuid
  location   Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String          @db.Uuid
  key        String // snake_case identifier used in Contact.customFields
  label      String
  type       CustomFieldType
  options    String[]        @default([]) // for SELECT
  createdAt  DateTime        @default(now())

  @@unique([locationId, key])
  @@map("custom_field_defs")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model Pipeline {
  id            String          @id @default(uuid()) @db.Uuid
  location      Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String          @db.Uuid
  name          String
  stages        PipelineStage[]
  opportunities Opportunity[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([locationId, name])
  @@map("pipelines")
}

model PipelineStage {
  id            String        @id @default(uuid()) @db.Uuid
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String        @db.Uuid
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId    String        @db.Uuid
  name          String
  position      Int
  opportunities Opportunity[]

  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model Opportunity {
  id            String            @id @default(uuid()) @db.Uuid
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String            @db.Uuid
  pipeline      Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId    String            @db.Uuid
  stage         PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  stageId       String            @db.Uuid
  contact       Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId     String            @db.Uuid
  name          String
  monetaryValue Decimal           @default(0) @db.Decimal(12, 2)
  status        OpportunityStatus @default(OPEN)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([locationId, pipelineId, stageId])
  @@map("opportunities")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

// One thread per contact per location, across every channel. The unified
// inbox is a list of these ordered by lastMessageAt.
model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  location           Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId         String    @db.Uuid
  contact            Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId          String    @db.Uuid
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  messages           Message[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([locationId, contactId])
  @@index([locationId, lastMessageAt])
  @@map("conversations")
}

// The normalized message envelope — every channel (SMS, email, DMs, calls,
// internal notes) flattens into this one shape. Getting this right is what
// makes each new channel an adapter instead of a rewrite.
model Message {
  id                String           @id @default(uuid()) @db.Uuid
  location          Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId        String           @db.Uuid
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String           @db.Uuid
  contact           Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId         String           @db.Uuid
  channel           MessageChannel
  direction         MessageDirection
  status            MessageStatus
  body              String
  attachments       Json             @default("[]")
  providerMessageId String? // Twilio SID, provider MID — idempotency key for webhook ingestion
  providerMeta      Json?
  sentByUserId      String?          @db.Uuid // team member who sent an outbound message
  occurredAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@unique([channel, providerMessageId])
  @@index([conversationId, occurredAt])
  @@index([locationId, occurredAt])
  @@map("messages")
}

enum MessageChannel {
  SMS
  EMAIL
  FB
  IG
  LIVECHAT
  CALL
  VOICEMAIL
  NOTE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// A bookable service/calendar. The public booking link is
// /book/:locationId/:slug — embedded on the client's existing site.
model Calendar {
  id              String        @id @default(uuid()) @db.Uuid
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId      String        @db.Uuid
  name            String
  slug            String
  timezone        String? // falls back to location.timezone
  slotDurationMin Int           @default(30)
  bufferMin       Int           @default(0)
  minNoticeMin    Int           @default(120)
  maxAdvanceDays  Int           @default(30)
  // {"mon":[["09:00","17:00"]], "tue":[...], ...} in the calendar's timezone
  weeklyHours     Json
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([locationId, slug])
  @@map("calendars")
}

model Appointment {
  id         String            @id @default(uuid()) @db.Uuid
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String            @db.Uuid
  calendar   Calendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String            @db.Uuid
  contact    Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String            @db.Uuid
  startsAt   DateTime          @db.Timestamptz(3)
  endsAt     DateTime          @db.Timestamptz(3)
  status     AppointmentStatus @default(CONFIRMED)
  notes      String?
  source     String? // booking-page, manual, ...
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([locationId, startsAt])
  @@index([calendarId, startsAt])
  @@map("appointments")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

// A per-location automation. Definitions are JSON step lists (see
// workflows/templates.ts for the shapes); the template catalog stamps proven
// automations into any location — nothing is client-specific.
model Workflow {
  id          String              @id @default(uuid()) @db.Uuid
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String              @db.Uuid
  name        String
  trigger     WorkflowTrigger
  // trigger refinement (e.g. {"offsetHours": -24} for reminders)
  triggerConfig Json              @default("{}")
  steps       Json // ordered step list
  stopOnReply Boolean             @default(true)
  status      WorkflowStatus      @default(PAUSED)
  version     Int                 @default(1)
  executions  WorkflowExecution[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([locationId, trigger, status])
  @@map("workflows")
}

enum WorkflowTrigger {
  CONTACT_CREATED
  APPOINTMENT_BOOKED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  MANUAL
}

enum WorkflowStatus {
  ACTIVE
  PAUSED
}

// A durable, resumable run of one workflow for one contact. The step list is
// snapshotted at enrollment — editing a workflow never mutates in-flight runs.
model WorkflowExecution {
  id          String          @id @default(uuid()) @db.Uuid
  location    Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String          @db.Uuid
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId  String          @db.Uuid
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String          @db.Uuid
  stepsSnapshot Json // pinned definition
  stopOnReply Boolean         @default(true)
  currentStep Int             @default(0)
  context     Json            @default("{}")
  status      ExecutionStatus @default(RUNNING)
  resumeAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([locationId, status])
  @@index([contactId, status])
  @@map("workflow_executions")
}

enum ExecutionStatus {
  RUNNING
  WAITING
  COMPLETED
  CANCELLED
  FAILED
}

enum CostType {
  SMS_OUT
  SMS_IN
  MMS_OUT
  VOICE_MIN
  EMAIL_SENT
  AI_TOKENS
  NUMBER_RENTAL
  SOCIAL_POST
  OTHER
}
