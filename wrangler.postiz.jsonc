{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "postiz",
	"main": "postiz-worker/index.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"containers": [
		{
			// Cloudflare Containers can't pull directly from ghcr.io (only
			// AWS ECR / DockerHub / Google Artifact Registry are supported
			// external registries) — this one-line Dockerfile is a pure
			// passthrough that lets our own build pull it and push the
			// result to Cloudflare's own registry instead.
			"image": "./Dockerfile.postiz",
			"class_name": "PostizContainer",
			"max_instances": 2,
			"instance_type": "standard-1"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "POSTIZ_CONTAINER", "class_name": "PostizContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PostizContainer"] }]
	// No Hyperdrive — same lesson as growthops-api: Hyperdrive doesn't work
	// inside Containers, connect straight to Neon via a plain secret.
}
