{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "postiz",
	"main": "postiz-worker/index.ts",
	"compatibility_date": "2026-07-22",
	"compatibility_flags": ["nodejs_compat"],
	"containers": [
		{
			// Cloudflare Containers can't pull directly from ghcr.io (only
			// AWS ECR / DockerHub / Google Artifact Registry are supported
			// external registries) — this one-line Dockerfile is a pure
			// passthrough that lets our own build pull it and push the
			// result to Cloudflare's own registry instead.
			"image": "./Dockerfile.postiz",
			"class_name": "PostizContainer",
			"max_instances": 2,
			// standard-1 (0.5 vCPU/4GiB) wasn't enough — nginx stayed up
			// (satisfying Cloudflare's own health check) but its upstream
			// (pm2-managed Next.js frontend + Node backend, alongside
			// Redis) kept failing, producing a permanent 502 from nginx
			// itself rather than the "container not running" wrapper
			// error. Postiz bundles two Node processes plus Redis plus
			// nginx, unlike the single-process API container.
			"instance_type": "standard-3"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "POSTIZ_CONTAINER", "class_name": "PostizContainer" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PostizContainer"] }],
	// No Hyperdrive — same lesson as growthops-api: Hyperdrive doesn't work
	// inside Containers, connect straight to Neon via a plain secret.
	// Off by default — without this, container stdout/exceptions never reach
	// wrangler tail or the dashboard's Logs view, which is why the backend
	// 502 investigation on 2026-07-25 couldn't see any actual error detail.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
