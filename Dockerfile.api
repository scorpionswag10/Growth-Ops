# Builds the NestJS API (+ its in-process BullMQ workers — there is no
# separate worker process in this repo) for deployment as a Cloudflare
# Container. Root-level and full-workspace-context on purpose: this is a
# pnpm monorepo, and apps/api depends on the sibling packages/db package,
# which Docker can only reach if the build context includes the whole repo
# (a context rooted at apps/api/ can never COPY files from outside it).
#
# Deliberately NOT pruning devDependencies before the final stage.
# Tried two different pnpm mechanisms for this (`pnpm deploy --prod`, then
# `pnpm prune --prod`) and both left real runtime dependencies — not just
# dev tooling — unresolvable: prisma/@prisma/client content present in the
# pnpm store but missing their top-level symlink after `deploy`, then
# reflect-metadata (a genuine runtime import in main.ts) missing the same
# way after `prune`. Confirmed both failures by actually testing the
# resulting tree in a truly isolated directory, not assumed. A full,
# unpruned `pnpm install` (the same command already proven correct all
# night in normal dev use) is the one thing verified to resolve correctly
# end to end — shipping devDependencies unused-but-present in the final
# image is a real but minor size cost, and clearly the safer trade given
# two different pruning mechanisms both broke real resolution here.
#
# The final stage keeps the entire monorepo directory layout intact rather
# than cherry-picking subpaths, specifically so pnpm's relative symlinks
# never break from being moved to a different relative structure.

FROM node:22-slim AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm install --frozen-lockfile

COPY packages/db packages/db
COPY apps/api apps/api

RUN pnpm --filter @growthops/db build && pnpm --filter @growthops/db generate
RUN pnpm --filter @growthops/api build

FROM node:22-slim AS runtime
WORKDIR /repo
COPY --from=build /repo ./
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
CMD ["node", "apps/api/dist/main.js"]
